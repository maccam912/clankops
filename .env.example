OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (must be available on OpenRouter)
# See https://openrouter.ai/models for options
MODEL_NAME=google/gemini-2.0-flash-exp:free

# Model context window and output caps.
# These help prevent "context_length_exceeded" errors by bounding history/output.
MODEL_CONTEXT_LENGTH=256000
MAX_COMPLETION_TOKENS=4096
AUTONOMOUS_MAX_COMPLETION_TOKENS=2048
PROMPT_TOKEN_MARGIN=2048
MAX_MESSAGE_HISTORY=50

# Optional: add a minimum delay (seconds) between LLM calls to reduce provider rate limits.
# Set to 0 to disable.
LLM_CALL_DELAY_SECONDS=1

# Seconds of idle before transitioning to journaling mode
IDLE_TIMEOUT=30

# Optional memory directory (identity/human/journal text files)
MEMORY_DIR=memory

# Optional: how long (seconds) to consider a scheduled message "stuck" in delivering state before retrying
SCHEDULE_STUCK_SECONDS=300

# Optional skills directory (markdown skills under SKILLS_DIR/<skill_id>/SKILL.md)
SKILLS_DIR=skills

# Optional MCP servers config path (overrides discovery of .mcp/servers*.json)
MCP_SERVERS_PATH=

# Optional SearXNG endpoint for JSON web search tool
SEARXNG_URL=

# Telegram mode settings (used when running with --telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# atproto-mcp (Bluesky / AT Protocol) server
# Use a Bluesky *App Password* (not your account password).
ATPROTO_IDENTIFIER=
ATPROTO_PASSWORD=
